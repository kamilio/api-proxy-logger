<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LLM Debugger Snapshots</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --bg: #f7f8fa;
            --bg-strong: #eef1f4;
            --panel: #ffffff;
            --panel-alt: #f6f8fa;
            --ink: #1d1f23;
            --muted: #5d6670;
            --accent: #10a37f;
            --accent-strong: #0f8a6b;
            --stroke: #e2e6ea;
            --success: #1a7f4a;
            --danger: #b3261e;
            --shadow-soft: 0 10px 26px rgba(15, 23, 42, 0.08);
            --focus: rgba(16, 163, 127, 0.22);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "IBM Plex Sans", "Helvetica Neue", sans-serif;
            background:
                radial-gradient(1200px 520px at 12% -10%, rgba(16, 163, 127, 0.12), transparent 60%),
                radial-gradient(1000px 500px at 95% -20%, rgba(15, 23, 42, 0.08), transparent 60%),
                linear-gradient(180deg, var(--bg) 0%, #f1f3f6 100%);
            color: var(--ink);
        }

        .page { min-height: 100vh; padding: 24px 18px 64px; }
        .shell { max-width: 1120px; margin: 0 auto; display: grid; gap: 22px; }

        .hero {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: flex-start;
            padding: 20px 22px;
            background: rgba(255, 255, 255, 0.92);
            border-radius: 20px;
            border: 1px solid var(--stroke);
            box-shadow: var(--shadow-soft);
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-size: 0.68rem;
            color: var(--muted);
            margin-bottom: 2px;
        }

        .title {
            font-family: "Sora", "Helvetica Neue", sans-serif;
            font-size: clamp(1.4rem, 1.4vw + 1.2rem, 2rem);
            margin: 0;
        }

        .subtitle { margin: 6px 0 0; color: var(--muted); line-height: 1.4; }

        .link-button, .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 8px 12px;
            border-radius: 12px;
            border: 1px solid var(--stroke);
            background: #fff;
            color: var(--ink);
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            font-family: inherit;
            transition: transform 160ms ease, box-shadow 160ms ease, color 160ms ease;
        }

        .link-button:hover, .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(16, 163, 127, 0.18);
            color: var(--accent-strong);
        }

        .tree { display: grid; gap: 18px; }

        .empty {
            padding: 48px 24px;
            background: var(--panel);
            border-radius: 20px;
            border: 1px dashed var(--stroke);
            text-align: center;
            color: var(--muted);
        }

        .host-group {
            display: grid;
            gap: 12px;
            padding: 18px;
            background: var(--panel);
            border: 1px solid var(--stroke);
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
        }

        .host-title, .model-title {
            margin: 0;
            font-family: "IBM Plex Mono", monospace;
            overflow-wrap: anywhere;
        }

        .host-title { font-size: 1rem; }
        .model-group { display: grid; gap: 10px; padding-top: 8px; }
        .model-title { font-size: 0.85rem; color: var(--muted); }

        .snapshot-list { display: grid; gap: 8px; }

        .snapshot-row {
            position: relative;
            display: grid;
            grid-template-columns: minmax(110px, 0.8fr) 78px 82px 190px minmax(180px, 1fr) auto;
            gap: 12px;
            align-items: center;
            padding: 12px;
            padding-right: 52px;
            border: 1px solid var(--stroke);
            border-radius: 14px;
            background: var(--panel-alt);
        }

        .cell-label {
            display: none;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
            font-weight: 700;
        }

        .mono {
            font-family: "IBM Plex Mono", monospace;
            font-size: 0.82rem;
            overflow-wrap: anywhere;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: fit-content;
            padding: 6px 10px;
            border-radius: 999px;
            background: var(--bg-strong);
            color: var(--ink);
            font-size: 0.75rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .pill.ok { color: var(--success); background: rgba(26, 127, 74, 0.12); }
        .pill.bad { color: var(--danger); background: rgba(179, 38, 30, 0.12); }
        .preview { color: var(--muted); overflow-wrap: anywhere; }

        .overflow {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 3;
        }

        .overflow-trigger {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            border: 1px solid var(--stroke);
            background: #fff;
            color: var(--ink);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
        }

        .overflow-panel {
            position: absolute;
            top: 40px;
            right: 0;
            min-width: 140px;
            padding: 6px;
            border-radius: 14px;
            border: 1px solid var(--stroke);
            background: #fff;
            box-shadow: var(--shadow-soft);
            display: none;
        }

        .overflow.is-open .overflow-panel { display: grid; gap: 4px; }

        .overflow-item {
            display: block;
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            padding: 8px 10px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--ink);
            cursor: pointer;
            font-family: inherit;
            text-decoration: none;
        }

        .overflow-item:hover { background: var(--panel-alt); }
        .overflow-item.is-danger { color: var(--danger); }

        @media (max-width: 840px) {
            .hero { display: grid; }
            .snapshot-row { grid-template-columns: 1fr; padding-right: 52px; }
            .cell-label { display: block; margin-bottom: 3px; }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="shell">
            <header class="hero">
                <div>
                    <div class="eyebrow">LLM Debugger</div>
                    <h1 class="title">Snapshots</h1>
                    <p class="subtitle">Cached request and response snapshots grouped by endpoint and model.</p>
                </div>
                <a class="link-button" href="/__viewer__">Requests</a>
            </header>

            <main class="tree">
                <% if (!groups.length) { %>
                    <div class="empty">No snapshots yet. Enable cache and make a request to populate this browser.</div>
                <% } %>
                <% groups.forEach((group) => { %>
                    <section class="host-group">
                        <h2 class="host-title"><%= group.hostPath %></h2>
                        <% group.models.forEach((model) => { %>
                            <section class="model-group">
                                <h3 class="model-title"><%= model.name %></h3>
                                <div class="snapshot-list">
                                    <% model.snapshots.forEach((snapshot) => { %>
                                        <% const status = Number(snapshot.status); %>
                                        <% const statusClass = Number.isFinite(status) ? (status < 400 ? 'ok' : 'bad') : ''; %>
                                        <% const routeHost = snapshot.routeHost || snapshot.host; %>
                                        <% const routeModel = snapshot.routeModel || model.name; %>
                                        <% const routeKey = snapshot.routeKey || snapshot.key; %>
                                        <% const detailHref = `/__viewer__/snapshots/${encodeURIComponent(routeHost)}/${encodeURIComponent(routeModel)}/${encodeURIComponent(routeKey)}`; %>
                                        <article class="snapshot-row"
                                            data-host="<%= routeHost %>"
                                            data-model="<%= routeModel %>"
                                            data-key="<%= routeKey %>">
                                            <div>
                                                <span class="cell-label">Key</span>
                                                <span class="mono"><%= snapshot.key %></span>
                                            </div>
                                            <div>
                                                <span class="cell-label">Method</span>
                                                <span class="pill"><%= snapshot.method %></span>
                                            </div>
                                            <div>
                                                <span class="cell-label">Status</span>
                                                <span class="pill <%= statusClass %>"><%= snapshot.status || 'n/a' %></span>
                                            </div>
                                            <div>
                                                <span class="cell-label">Recorded</span>
                                                <span class="mono"><%= snapshot.recordedAt || 'n/a' %></span>
                                            </div>
                                            <div>
                                                <span class="cell-label">Prompt</span>
                                                <span class="preview"><%= snapshot.promptPreview || 'No prompt preview' %></span>
                                            </div>
                                            <a class="link-button" href="<%= detailHref %>">Open</a>
                                            <div class="overflow">
                                                <button class="overflow-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Open snapshot actions">...</button>
                                                <div class="overflow-panel" role="menu">
                                                    <button class="overflow-item is-danger" type="button" role="menuitem">Delete</button>
                                                </div>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            </section>
                        <% }) %>
                    </section>
                <% }) %>
            </main>
        </div>
    </div>
    <script>
        const overflowMenus = Array.from(document.querySelectorAll('.overflow'));

        function closeOverflowMenus(except) {
            overflowMenus.forEach((menu) => {
                if (menu === except) return;
                menu.classList.remove('is-open');
                const trigger = menu.querySelector('.overflow-trigger');
                if (trigger) trigger.setAttribute('aria-expanded', 'false');
            });
        }

        async function deleteSnapshotRow(row, button) {
            if (!row) return;
            if (!confirm('Delete this snapshot? This cannot be undone.')) return;

            const url = `/__viewer__/snapshots/${encodeURIComponent(row.dataset.host)}/${encodeURIComponent(row.dataset.model)}/${encodeURIComponent(row.dataset.key)}`;
            button.disabled = true;
            button.textContent = 'Deleting...';

            try {
                const response = await fetch(url, { method: 'DELETE' });
                if (!response.ok) {
                    const data = await response.json().catch(() => ({}));
                    alert('Failed to delete: ' + (data.error || 'Unknown error'));
                    button.disabled = false;
                    button.textContent = 'Delete';
                    return;
                }
                window.location.reload();
            } catch (error) {
                alert('Failed to delete: ' + error.message);
                button.disabled = false;
                button.textContent = 'Delete';
            }
        }

        overflowMenus.forEach((menu) => {
            const trigger = menu.querySelector('.overflow-trigger');
            const deleteButton = menu.querySelector('.overflow-item.is-danger');
            const row = menu.closest('[data-host][data-model][data-key]');

            if (trigger) {
                trigger.addEventListener('click', (event) => {
                    event.stopPropagation();
                    const nextState = !menu.classList.contains('is-open');
                    closeOverflowMenus(menu);
                    menu.classList.toggle('is-open', nextState);
                    trigger.setAttribute('aria-expanded', nextState ? 'true' : 'false');
                });
            }

            if (deleteButton) {
                deleteButton.addEventListener('click', (event) => {
                    event.stopPropagation();
                    deleteSnapshotRow(row, deleteButton);
                });
            }
        });

        document.addEventListener('click', (event) => {
            if (event.target.closest('.overflow')) return;
            closeOverflowMenus();
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeOverflowMenus();
        });
    </script>
</body>
</html>
